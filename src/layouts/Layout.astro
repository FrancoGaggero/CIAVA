---
/**
 * Layout principal de CIAVA
 * Incluye meta tags, fonts y estilos globales
 */
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = 'CIAVA Studio — Fotografía y Video de Moda',
	description = 'Estudio creativo especializado en producción de contenido visual para marcas. Fotografía de moda, video, estilismo y dirección creativa en Buenos Aires.'
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0a0a0a" />
		
		<!-- SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
		
		<!-- Google Fonts: Cormorant Garamond (headings) + Inter (body) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link 
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500;600&display=swap" 
			rel="stylesheet" 
		/>
	</head>
	<body class="antialiased bg-ciava-black font-sans">
		<Header />
		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}
</style>
