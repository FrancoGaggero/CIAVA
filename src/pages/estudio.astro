---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';

import heroImg1 from '../assets/images/estudio/6550b84a-eaf9-4480-81ac-16bb114c542b.jpg';
import heroImg2 from '../assets/images/estudio/73e74536-553d-4ab4-b2f6-06c636cd7440.jpg';
import estudio1 from '../assets/images/estudio/fotoestudio1.jpg';
import estudio2 from '../assets/images/estudio/fotoestudio2.jpg';
import estudio3 from '../assets/images/estudio/fotoestudio3.jpg';

const galleryPhotos = [estudio1, estudio2, estudio3, heroImg1, heroImg2];
---

<Layout 
  title="Nuestro Estudio en Nordelta - CIAVA STUDIO"
  description="Estudio de 120m² en Nordelta diseñado para producciones de moda y contenido visual profesional. Tres ambientes, equipamiento profesional Godox y espacio de maquillaje."
>
  <!-- Hero Section -->
  <section id="hero-studio" class="relative w-full bg-ciava-black">
    <div class="flex flex-col items-center justify-center px-4 sm:px-6 pt-32 sm:pt-36 md:pt-40 pb-16 sm:pb-20 md:pb-24">
      <h1 class="hero-title mb-6 sm:mb-8 text-3xl sm:text-4xl md:text-5xl font-serif font-extralight tracking-[0.15em] sm:tracking-[0.2em] md:tracking-[0.25em] text-ciava-warm lg:text-7xl xl:text-8xl text-center">
        NUESTRO ESTUDIO
      </h1>
      <div class="mb-6 sm:mb-8 line-accent w-16 sm:w-20"></div>
      <p class="hero-subtitle max-w-2xl text-center text-xs sm:text-sm md:text-base font-light tracking-wide text-white/60 lg:text-lg leading-relaxed px-4">
        Un espacio de 80m² en Nordelta diseñado específicamente para producciones de moda y contenido visual profesional
      </p>
      
      <!-- Stats rápidos -->
      <div class="mt-8 sm:mt-12 grid grid-cols-3 gap-6 sm:gap-8 md:gap-12 text-center">
        <div class="stat-item">
          <div class="text-2xl sm:text-3xl md:text-4xl font-serif font-extralight text-ciava-gold mb-1 sm:mb-2">80</div>
          <div class="text-[10px] sm:text-xs text-white/40 tracking-wider">M² TOTALES</div>
        </div>
        <div class="stat-item">
          <div class="text-2xl sm:text-3xl md:text-4xl font-serif font-extralight text-ciava-gold mb-1 sm:mb-2">2</div>
          <div class="text-[10px] sm:text-xs text-white/40 tracking-wider">AMBIENTES</div>
        </div>
        <div class="stat-item">
          <div class="text-2xl sm:text-3xl md:text-4xl font-serif font-extralight text-ciava-gold mb-1 sm:mb-2">2</div>
          <div class="text-[10px] sm:text-xs text-white/40 tracking-wider">BAÑOS</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Galería del Estudio -->
  <section class="bg-ciava-black pb-16 px-4 sm:px-6 md:pb-24">
    <div class="container mx-auto max-w-7xl">
      <div class="studio-gallery grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4">
        <!-- Imagen principal grande -->
        <div class="studio-gallery-item group relative overflow-hidden lg:col-span-2 lg:row-span-2">
          <div class="relative w-full aspect-[4/3] lg:aspect-auto lg:h-full min-h-[300px] lg:min-h-[500px]">
            <Image
              src={galleryPhotos[0]}
              alt="Estudio CIAVA - Vista principal"
              class="absolute inset-0 h-full w-full object-cover transition-all duration-700 ease-out group-hover:scale-[1.03]"
              widths={[600, 900, 1200]}
              sizes="(max-width: 768px) 100vw, 66vw"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
          </div>
        </div>
        <!-- Imagen 2 -->
        <div class="studio-gallery-item group relative overflow-hidden">
          <div class="relative w-full aspect-[4/3]">
            <Image
              src={galleryPhotos[1]}
              alt="Estudio CIAVA - Detalle"
              class="absolute inset-0 h-full w-full object-cover transition-all duration-700 ease-out group-hover:scale-[1.03]"
              widths={[400, 600]}
              sizes="(max-width: 768px) 100vw, 33vw"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
          </div>
        </div>
        <!-- Imagen 3 -->
        <div class="studio-gallery-item group relative overflow-hidden">
          <div class="relative w-full aspect-[4/3]">
            <Image
              src={galleryPhotos[2]}
              alt="Estudio CIAVA - Ambiente"
              class="absolute inset-0 h-full w-full object-cover transition-all duration-700 ease-out group-hover:scale-[1.03]"
              widths={[400, 600]}
              sizes="(max-width: 768px) 100vw, 33vw"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
          </div>
        </div>
        <!-- Imagen 4 -->
        <div class="studio-gallery-item group relative overflow-hidden">
          <div class="relative w-full aspect-[4/3]">
            <Image
              src={galleryPhotos[3]}
              alt="Estudio CIAVA - Equipamiento"
              class="absolute inset-0 h-full w-full object-cover transition-all duration-700 ease-out group-hover:scale-[1.03]"
              widths={[400, 600]}
              sizes="(max-width: 768px) 100vw, 33vw"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
          </div>
        </div>
        <!-- Imagen 5 grande -->
        <div class="studio-gallery-item group relative overflow-hidden lg:col-span-2">
          <div class="relative w-full aspect-[4/3] lg:aspect-[16/9]">
            <Image
              src={galleryPhotos[4]}
              alt="Estudio CIAVA - Espacio completo"
              class="absolute inset-0 h-full w-full object-cover transition-all duration-700 ease-out group-hover:scale-[1.03]"
              widths={[600, 900, 1200]}
              sizes="(max-width: 768px) 100vw, 66vw"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Información Principal -->
  <section class="bg-ciava-dark py-32 px-6 md:py-40">
    <div class="container mx-auto max-w-6xl">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <!-- Texto principal -->
        <div class="border border-white/5 bg-ciava-charcoal/30 px-12 py-16 md:px-16 md:py-20">
          <div class="mb-12 text-center lg:text-left">
            <div class="line-accent w-12 mb-8 mx-auto lg:mx-0"></div>
            <h2 class="mb-8 text-2xl font-serif font-light tracking-[0.15em] text-ciava-warm md:text-3xl">
              MARZO 2026
            </h2>
            <div class="line-accent w-12 mx-auto lg:mx-0"></div>
          </div>
          
          <div class="space-y-8 text-lg leading-relaxed text-white/50 font-light">
            <p class="tracking-wide">
              En marzo de 2026 abrimos nuestro propio espacio de trabajo en Nordelta, un estudio diseñado específicamente para producciones de moda y contenido visual.
            </p>
            <p class="tracking-wide">
              Un lugar donde la creatividad se encuentra con la funcionalidad, equipado con todo lo necesario para materializar ideas desde la preproducción hasta el resultado final.
            </p>
          </div>
        </div>

        <!-- Datos Técnicos -->
        <div class="border border-white/5 bg-ciava-charcoal/30 px-10 py-12 md:px-12 md:py-16">
          <div class="mb-8 border-l-2 border-ciava-gold/30 pl-6">
            <h3 class="text-lg font-serif font-light tracking-[0.15em] text-ciava-warm">
              DATOS TÉCNICOS
            </h3>
          </div>

          <div class="space-y-6">
            <div class="flex items-start gap-4 pb-4 border-b border-white/5">
              <svg class="h-5 w-5 mt-0.5 text-ciava-gold/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <div class="flex-1">
                <p class="text-xs tracking-wider text-ciava-gold/40 uppercase mb-1">Ubicación</p>
                <p class="text-sm font-light text-white/60">Nordelta, Tigre, Buenos Aires</p>
              </div>
            </div>

            <div class="flex items-start gap-4 pb-4 border-b border-white/5">
              <svg class="h-5 w-5 mt-0.5 text-ciava-gold/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-3zM14 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1h-4a1 1 0 01-1-1v-3z"></path>
              </svg>
              <div class="flex-1">
                <p class="text-xs tracking-wider text-ciava-gold/40 uppercase mb-1">Superficie</p>
                <p class="text-sm font-light text-white/60">80 m² totales</p>
              </div>
            </div>

            <div class="flex items-start gap-4 pb-4 border-b border-white/5">
              <svg class="h-5 w-5 mt-0.5 text-ciava-gold/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707"></path>
              </svg>
              <div class="flex-1">
                <p class="text-xs tracking-wider text-ciava-gold/40 uppercase mb-1">Orientación</p>
                <p class="text-sm font-light text-white/60">Norte con luz natural</p>
              </div>
            </div>

            <div class="flex items-start gap-4 pb-4 border-b border-white/5">
              <svg class="h-5 w-5 mt-0.5 text-ciava-gold/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
              </svg>
              <div class="flex-1">
                <p class="text-xs tracking-wider text-ciava-gold/40 uppercase mb-1">Espacios</p>
                <p class="text-sm font-light text-white/60">2 ambientes principales</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <svg class="h-5 w-5 mt-0.5 text-ciava-gold/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
              <div class="flex-1">
                <p class="text-xs tracking-wider text-ciava-gold/40 uppercase mb-1">Baños</p>
                <p class="text-sm font-light text-white/60">2 baños completos</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Equipamiento Disponible -->
  <section class="bg-ciava-charcoal py-32 px-6 md:py-40">
    <div class="container mx-auto max-w-6xl">
      <div class="mb-20 text-center">
        <div class="line-accent w-12 mx-auto mb-8"></div>
        <h2 class="text-2xl font-serif font-light tracking-[0.15em] text-ciava-warm md:text-3xl">
          EQUIPAMIENTO DISPONIBLE
        </h2>
        <div class="line-accent w-12 mx-auto mt-8"></div>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <!-- Item 1 -->
        <div class="equipment-card group border border-white/5 bg-ciava-dark/50 p-8 transition-all duration-500 hover:border-ciava-gold/15 hover:shadow-elevation-2 hover:-translate-y-2">
          <div class="mb-6 flex h-14 w-14 items-center justify-center border border-ciava-gold/10 bg-ciava-charcoal/60 transition-all duration-500 group-hover:scale-110 group-hover:border-ciava-gold/40 group-hover:bg-ciava-gold group-hover:rotate-6">
            <svg class="h-7 w-7 text-ciava-gold/50 transition-colors group-hover:text-ciava-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-sm font-light tracking-wide text-ciava-warm">Iluminación Profesional</h3>
          <p class="text-xs leading-relaxed text-white/40 font-light">Flashes de estudio, softboxes, reflectores y paneles LED</p>
        </div>

        <!-- Item 2 -->
        <div class="equipment-card group border border-white/5 bg-ciava-dark/50 p-8 transition-all duration-500 hover:border-ciava-gold/15 hover:shadow-elevation-2 hover:-translate-y-2">
          <div class="mb-6 flex h-14 w-14 items-center justify-center border border-ciava-gold/10 bg-ciava-charcoal/60 transition-all duration-500 group-hover:scale-110 group-hover:border-ciava-gold/40 group-hover:bg-ciava-gold group-hover:rotate-6">
            <svg class="h-7 w-7 text-ciava-gold/50 transition-colors group-hover:text-ciava-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-sm font-light tracking-wide text-ciava-warm">Fondos y Backdrops</h3>
          <p class="text-xs leading-relaxed text-white/40 font-light">Fondos blancos, negros, grises y de colores. Sistema de fondos colgantes</p>
        </div>

        <!-- Item 3 -->
        <div class="equipment-card group border border-white/5 bg-ciava-dark/50 p-8 transition-all duration-500 hover:border-ciava-gold/15 hover:shadow-elevation-2 hover:-translate-y-2">
          <div class="mb-6 flex h-14 w-14 items-center justify-center border border-ciava-gold/10 bg-ciava-charcoal/60 transition-all duration-500 group-hover:scale-110 group-hover:border-ciava-gold/40 group-hover:bg-ciava-gold group-hover:rotate-6">
            <svg class="h-7 w-7 text-ciava-gold/50 transition-colors group-hover:text-ciava-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-sm font-light tracking-wide text-ciava-warm">Área de Trabajo Digital</h3>
          <p class="text-xs leading-relaxed text-white/40 font-light">Computadoras con software profesional para edición en el momento</p>
        </div>

        <!-- Item 4 -->
        <div class="equipment-card group border border-white/5 bg-ciava-dark/50 p-8 transition-all duration-500 hover:border-ciava-gold/15 hover:shadow-elevation-2 hover:-translate-y-2">
          <div class="mb-6 flex h-14 w-14 items-center justify-center border border-ciava-gold/10 bg-ciava-charcoal/60 transition-all duration-500 group-hover:scale-110 group-hover:border-ciava-gold/40 group-hover:bg-ciava-gold group-hover:rotate-6">
            <svg class="h-7 w-7 text-ciava-gold/50 transition-colors group-hover:text-ciava-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-sm font-light tracking-wide text-ciava-warm">Zona de Vestuario y Makeup</h3>
          <p class="text-xs leading-relaxed text-white/40 font-light">Espacio dedicado con espejos, iluminación y rack para prendas</p>
        </div>

        <!-- Item 5 -->
        <div class="equipment-card group border border-white/5 bg-ciava-dark/50 p-8 transition-all duration-500 hover:border-ciava-gold/15 hover:shadow-elevation-2 hover:-translate-y-2">
          <div class="mb-6 flex h-14 w-14 items-center justify-center border border-ciava-gold/10 bg-ciava-charcoal/60 transition-all duration-500 group-hover:scale-110 group-hover:border-ciava-gold/40 group-hover:bg-ciava-gold group-hover:rotate-6">
            <svg class="h-7 w-7 text-ciava-gold/50 transition-colors group-hover:text-ciava-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-sm font-light tracking-wide text-ciava-warm">WiFi de Alta Velocidad</h3>
          <p class="text-xs leading-relaxed text-white/40 font-light">Conexión de fibra óptica para transferencias y trabajo remoto</p>
        </div>

        <!-- Item 6 -->
        <div class="equipment-card group border border-white/5 bg-ciava-dark/50 p-8 transition-all duration-500 hover:border-ciava-gold/15 hover:shadow-elevation-2 hover:-translate-y-2">
          <div class="mb-6 flex h-14 w-14 items-center justify-center border border-ciava-gold/10 bg-ciava-charcoal/60 transition-all duration-500 group-hover:scale-110 group-hover:border-ciava-gold/40 group-hover:bg-ciava-gold group-hover:rotate-6">
            <svg class="h-7 w-7 text-ciava-gold/50 transition-colors group-hover:text-ciava-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-sm font-light tracking-wide text-ciava-warm">Zona Lounge</h3>
          <p class="text-xs leading-relaxed text-white/40 font-light">Área de descanso con kitchenette para breaks durante la producción</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Información de Alquiler -->
  <section class="bg-ciava-dark py-32 px-6 md:py-40">
    <div class="container mx-auto max-w-5xl">
      <div class="mb-20 text-center">
        <div class="line-accent w-12 mx-auto mb-8"></div>
        <h2 class="text-2xl font-serif font-light tracking-[0.15em] text-ciava-warm md:text-3xl">
          INFORMACIÓN DE ALQUILER
        </h2>
        <div class="line-accent w-12 mx-auto mt-8"></div>
      </div>

      <div class="border border-white/5 bg-ciava-charcoal/30 px-12 py-16 md:px-16 md:py-20">
        <div class="space-y-12">
          <!-- Modalidades -->
          <div>
            <h3 class="mb-6 border-l-2 border-ciava-gold/30 pl-6 text-lg font-serif font-light tracking-[0.15em] text-ciava-warm">
              MODALIDADES DISPONIBLES
            </h3>
            <div class="grid gap-6 md:grid-cols-2">
              <div class="border-l border-white/10 pl-6 py-2">
                <p class="mb-2 text-sm font-light tracking-wide text-ciava-warm">Por Hora</p>
                <p class="text-xs leading-relaxed text-white/40 font-light">Ideal para sesiones cortas o pruebas de concepto</p>
              </div>
              <div class="border-l border-white/10 pl-6 py-2">
                <p class="mb-2 text-sm font-light tracking-wide text-ciava-warm">Por Día Completo</p>
                <p class="text-xs leading-relaxed text-white/40 font-light">Jornada completa para producciones extensas</p>
              </div>
              <div class="border-l border-white/10 pl-6 py-2">
                <p class="mb-2 text-sm font-light tracking-wide text-ciava-warm">Paquetes Mensuales</p>
                <p class="text-xs leading-relaxed text-white/40 font-light">Para clientes recurrentes con tarifas preferenciales</p>
              </div>
              <div class="border-l border-white/10 pl-6 py-2">
                <p class="mb-2 text-sm font-light tracking-wide text-ciava-warm">Producción Completa</p>
                <p class="text-xs leading-relaxed text-white/40 font-light">Incluye espacio + equipo + nuestro equipo profesional</p>
              </div>
            </div>
          </div>

          <!-- Incluye -->
          <div>
            <h3 class="mb-6 border-l-2 border-ciava-gold/30 pl-6 text-lg font-serif font-light tracking-[0.15em] text-ciava-warm">
              QUÉ INCLUYE
            </h3>
            <div class="space-y-3 text-sm font-light text-white/50">
              <div class="flex items-start gap-3">
                <svg class="h-5 w-5 mt-0.5 text-ciava-gold/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <p>Uso completo del espacio y equipamiento básico</p>
              </div>
              <div class="flex items-start gap-3">
                <svg class="h-5 w-5 mt-0.5 text-ciava-gold/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
