---
/**
 * Studio Nordelta Component
 * Coming Soon - Marzo 2026
 */
---

<section id="studio" class="relative bg-ciava-charcoal py-20 sm:py-32 md:py-40 lg:py-48 px-4 sm:px-6 overflow-hidden">
  <!-- Líneas decorativas sutiles -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(201,169,110,0.3) 1px, transparent 1px); background-size: 1px 80px;"></div>
  
  <div class="container mx-auto max-w-4xl text-center relative z-10">
    <a 
      href="/estudio" 
      class="studio-link group block border border-ciava-gold/10 bg-ciava-dark/50 px-6 py-10 sm:px-10 sm:py-14 md:px-12 md:py-16 lg:px-16 lg:py-20 transition-all duration-700 hover:border-ciava-gold/30 hover:bg-ciava-dark/80 hover:scale-[1.02] backdrop-blur-sm relative overflow-hidden hover:shadow-elevation-3"
    >
      <!-- Animated gradient on hover -->
      <div class="absolute inset-0 bg-gradient-to-r from-ciava-gold/0 via-ciava-gold/[0.04] to-ciava-gold/0 translate-x-[-100%] transition-transform duration-1000 group-hover:translate-x-[100%]"></div>
      
      <!-- Badge 
      <div class="studio-badge mb-6 sm:mb-8 relative">
        <span class="inline-block border border-ciava-gold/20 bg-ciava-gold/5 px-4 py-2 sm:px-6 sm:py-3 text-[10px] sm:text-xs font-light tracking-[0.25em] sm:tracking-[0.3em] text-ciava-gold/80 transition-all duration-500 group-hover:border-ciava-gold/50 group-hover:tracking-[0.35em] group-hover:bg-ciava-gold/10">
          COMING SOON
        </span>
      </div>
    -->
      <!-- Fecha -->
      <h2 class="studio-title mb-4 sm:mb-6 text-2xl sm:text-4xl font-serif font-extralight tracking-[0.15em] sm:tracking-[0.2em] text-ciava-warm md:text-5xl lg:text-6xl transition-all duration-500 group-hover:text-white relative">
        OPEN NOW
      </h2>

      <div class="line-accent w-12 sm:w-16 mx-auto mb-6 sm:mb-8 transition-all duration-500 group-hover:w-24"></div>

      <!-- Descripción -->
      <p class="studio-description mb-4 sm:mb-6 text-sm sm:text-base leading-relaxed text-white/50 font-light tracking-wide md:text-lg transition-all duration-500 group-hover:text-white/80 relative">
        Inauguramos nuestro estudio en Nordelta.
      </p>

      <!-- CTA -->
      <div class="inline-flex items-center gap-2 text-xs tracking-[0.2em] text-ciava-gold/50 transition-all duration-500 group-hover:text-ciava-gold group-hover:gap-4 relative">
        <span>MÁS INFORMACIÓN</span>
        <svg class="h-4 w-4 transition-transform duration-500 group-hover:translate-x-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path>
        </svg>
      </div>
    </a>
  </div>
</section>

<script>
  import anime from 'animejs';

  function initStudioAnimations() {
    const studioLink = document.querySelector('.studio-link');
    
    if (!studioLink) return;
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !entry.target.hasAttribute('data-animated')) {
          entry.target.setAttribute('data-animated', 'true');
          
          anime.timeline({
            easing: 'easeOutExpo',
          })
          .add({
            targets: '.studio-badge',
            opacity: [0, 1],
            scale: [0.8, 1],
            duration: 800,
          })
          .add({
            targets: '.studio-title',
            opacity: [0, 1],
            translateY: [30, 0],
            duration: 1000,
          }, '-=600')
          .add({
            targets: '.studio-description',
            opacity: [0, 1],
            translateY: [20, 0],
            duration: 800,
          }, '-=600');
        }
      });
    }, { threshold: 0.3 });
    
    observer.observe(studioLink);
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStudioAnimations);
  } else {
    initStudioAnimations();
  }
  
  document.addEventListener('astro:page-load', initStudioAnimations);
</script>
