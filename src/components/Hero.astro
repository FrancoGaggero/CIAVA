---
/**
 * Hero Component
 * Imagen vertical para mobile, horizontal para desktop
 */
import { Image } from 'astro:assets';
import { resolveImageWarn } from '../lib/images';
import hero from '../data/hero.json';

const heroMobile = resolveImageWarn(hero.imageMobile, 'hero — celular');
const heroDesktop = resolveImageWarn(hero.imageDesktop, 'hero — escritorio');
---

<section id="hero" class="relative min-h-screen w-full overflow-hidden bg-ciava-black">
  <!-- Imagen mobile (vertical) - visible solo en mobile/tablet -->
  <div class="absolute inset-0 md:hidden">
    {heroMobile && (
      <Image
        src={heroMobile}
        alt="CIAVA Studio — Estudio de fotografía de moda en Buenos Aires"
        class="h-full w-full object-cover opacity-90"
        style="object-position: center 1%;"
        widths={[640, 960]}
        sizes="100vw"
        loading="eager"
        decoding="async"
        quality={80}
      />
    )}
  </div>

  <!-- Imagen desktop (horizontal) - visible solo en desktop -->
  <div class="absolute inset-0 hidden md:block">
    {heroDesktop && (
      <Image
        src={heroDesktop}
        alt="CIAVA Studio — Estudio de fotografía de moda en Buenos Aires"
        class="h-full w-full object-cover opacity-[0.72]"
        style="object-position: center center;"
        widths={[1280, 1920]}
        sizes="100vw"
        loading="eager"
        decoding="async"
        quality={80}
      />
    )}
  </div>

  <!-- Overlays (compartidos) -->
  <div class="absolute inset-0 bg-gradient-to-b from-ciava-black/60 via-ciava-black/15 to-ciava-black/85"></div>
  <!-- Refuerzo de legibilidad detrás del título -->
  <div class="absolute inset-0" style="background: radial-gradient(ellipse 60% 45% at center 48%, rgba(10,10,10,0.55) 0%, transparent 70%);"></div>
  <!-- Viñeta envolvente -->
  <div class="absolute inset-0" style="background: radial-gradient(ellipse at center, transparent 45%, rgba(10,10,10,0.7) 100%);"></div>

  <!-- Contenido centrado -->
  <div class="relative z-10 flex min-h-screen flex-col items-center justify-center px-6 py-20">
    <!-- Pequeño acento dorado -->
    <div class="mb-6 sm:mb-8 h-8 w-px bg-gradient-to-b from-transparent via-ciava-gold/60 to-transparent"></div>
    
    <h1 
      id="hero-title"
      class="hero-title mb-4 text-center font-serif text-[clamp(2.25rem,9vw,8rem)] font-light tracking-[0.08em] text-white sm:mb-6 sm:tracking-[0.12em] md:tracking-[0.15em] leading-[0.9]"
    >
      {hero.title}
    </h1>
    
    <div class="mb-5 sm:mb-6 line-accent w-16 sm:w-24"></div>
    
    <p 
      id="hero-subtitle"
      class="hero-subtitle max-w-xs text-center text-[10px] font-light tracking-[0.2em] text-white/70 sm:max-w-md sm:text-xs sm:tracking-[0.25em] md:max-w-lg md:text-sm"
    >
      {hero.subtitle}
    </p>

    <!-- Pequeño acento dorado -->
    <div class="mt-6 sm:mt-8 h-8 w-px bg-gradient-to-b from-ciava-gold/40 via-transparent to-transparent"></div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2 sm:bottom-12">
    <div class="flex flex-col items-center gap-2 animate-pulse-soft">
      <span class="text-[9px] font-light tracking-[0.3em] text-ciava-gold/50 sm:text-[10px]">SCROLL</span>
      <svg class="h-4 w-4 text-ciava-gold/40 sm:h-5 sm:w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </div>
</section>

<script>
  import '../scripts/heroAnimations.js';
</script>
