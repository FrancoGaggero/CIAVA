---
/**
 * Hero Component
 * Imagen apaisada con título CIAVA STUDIO
 */
import heroImage from '../assets/images/hero/fondo.jpeg';
---

<section id="hero" class="relative min-h-screen w-full overflow-hidden bg-black">
  <!-- Imagen apaisada con overlay sutil -->
  <div class="absolute inset-0">
    <img 
      src={heroImage.src} 
      alt="CIAVA Studio" 
      class="h-full w-full object-cover opacity-75"
      style="object-position: center center;"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-transparent to-black/50"></div>
  </div>

  <!-- Título superpuesto centrado -->
  <div class="relative z-10 flex min-h-screen flex-col items-center justify-center px-6 py-20">
    <h1 
      id="hero-title"
      class="hero-title mb-4 text-center text-[clamp(1.75rem,8vw,7rem)] font-extralight tracking-[0.15em] text-white sm:mb-6 sm:tracking-[0.25em] md:tracking-[0.35em]"
    >
      CIAVA STUDIO
    </h1>
    <div class="mb-4 h-px w-12 bg-white/40 sm:mb-6 sm:w-16"></div>
    <p 
      id="hero-subtitle"
      class="hero-subtitle max-w-xs text-center text-[10px] font-light tracking-[0.15em] text-white/90 sm:max-w-md sm:text-xs sm:tracking-[0.2em] md:max-w-lg md:text-sm md:tracking-[0.25em]"
    >
      FOTOGRAFÍA Y VIDEO DE MODA PARA MARCAS
    </p>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2 animate-bounce sm:bottom-12">
    <div class="flex flex-col items-center gap-2">
      <span class="text-[10px] font-light tracking-wider text-white/60 sm:text-xs">SCROLL</span>
      <svg class="h-4 w-4 text-white/60 sm:h-5 sm:w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </div>
</section>

<script>
  import '../scripts/heroAnimations.js';
</script>
