---
/**
 * Intro Component
 * Descripción del estudio
 */
import { Image } from 'astro:assets';
import muestra1 from '../assets/images/studio/muestra1.jpeg';
import muestra3 from '../assets/images/studio/muestra3.jpeg';
---

<section id="intro" class="bg-ciava-dark py-20 sm:py-28 md:py-36 lg:py-44 px-4 sm:px-6">
  <div class="container mx-auto max-w-6xl">
    <div class="intro-content text-center">
      <div class="mx-auto max-w-4xl border border-white/5 bg-ciava-charcoal/40 px-6 py-10 sm:px-12 sm:py-16 md:px-16 md:py-20 mb-14 sm:mb-20">
        <div class="mb-6 sm:mb-8 inline-block">
          <div class="line-accent w-10 sm:w-12 mx-auto mb-6 sm:mb-8"></div>
          <h2 class="mb-6 sm:mb-8 text-xl sm:text-2xl font-serif font-light tracking-[0.15em] text-ciava-warm md:text-3xl">
            CIAVA STUDIO
          </h2>
          <div class="line-accent w-10 sm:w-12 mx-auto"></div>
        </div>
        <div class="space-y-4 sm:space-y-6 md:space-y-8 text-sm sm:text-base md:text-lg leading-relaxed text-white/60 lg:text-xl font-light max-w-3xl mx-auto">
          <p class="tracking-wide">
            Somos un estudio creativo especializado en producción de contenido visual para marcas.
          </p>
          <p class="tracking-wide">
            Creamos imágenes y videos que comunican identidad, elevan el producto y potencian la presencia.
          </p>
        </div>
      </div>

      <!-- Grid de Producciones -->
      <div>
        <div class="mb-10 sm:mb-12 md:mb-14">
          <h3 class="text-lg sm:text-xl font-serif font-light tracking-[0.15em] text-ciava-warm md:text-2xl mb-2 sm:mb-3">
            TRABAJA CON NOSOTROS
          </h3>
          <p class="text-xs sm:text-sm font-light text-ciava-gold/60">Acá nace tu marca</p>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:gap-6 md:grid-cols-2 lg:gap-8">
          <!-- Imagen 1 -->
          <div class="production-item group relative aspect-[4/5] overflow-hidden bg-ciava-charcoal opacity-0" style="transform: scale(0.8);">
            <Image 
              src={muestra1} 
              alt="Sesión de fotografía de moda en estudio CIAVA" 
              class="h-full w-full object-cover transition-all duration-700 group-hover:scale-105"
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 50vw"
              loading="lazy"
              decoding="async"
              quality={80}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ciava-black/70 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
          </div>

          <!-- Imagen 3 -->
          <div class="production-item group relative aspect-[4/5] overflow-hidden bg-ciava-charcoal opacity-0" style="transform: scale(0.8);">
            <Image 
              src={muestra3} 
              alt="Producción fotográfica de indumentaria para marca" 
              class="h-full w-full object-cover transition-all duration-700 group-hover:scale-105"
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 50vw"
              loading="lazy"
              decoding="async"
              quality={80}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ciava-black/70 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import anime from 'animejs';

  function initProductionAnimations() {
    const productionItems = document.querySelectorAll('.production-item');
    
    if (!productionItems.length) {
      console.log('No production items found');
      return;
    }

    // Configurar observer para animaciones en scroll
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !entry.target.hasAttribute('data-animated')) {
          entry.target.setAttribute('data-animated', 'true');
          
          // Obtener el índice del item para calcular el delay
          const items = Array.from(productionItems);
          const index = items.indexOf(entry.target);
          
          // Animar individualmente cada imagen cuando entra en vista
          anime({
            targets: entry.target,
            scale: [0.8, 1],
            opacity: [0, 1],
            duration: 800,
            delay: index * 150,
            easing: 'easeOutElastic(1, .8)',
          });
        }
      });
    }, observerOptions);

    // Observar cada item individualmente
    productionItems.forEach(item => {
      observer.observe(item);
    });
  }

  // Ejecutar cuando la página cargue
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductionAnimations);
  } else {
    initProductionAnimations();
  }
  
  // También ejecutar en navegación SPA
  document.addEventListener('astro:page-load', initProductionAnimations);
</script>
