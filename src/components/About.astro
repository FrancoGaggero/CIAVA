---
/**
 * About Component
 * Quiénes somos: Florencia y Valentina
 */
import portadaFlor from '../assets/images/portadaFlor.jpg';
import portadaValen from '../assets/images/portadaValen.jpeg';
---

<section id="about" class="bg-ciava-black py-20 sm:py-28 md:py-36 lg:py-44 px-4 sm:px-6">
  <div class="container mx-auto max-w-6xl">
    <!-- Título -->
    <div class="mb-12 sm:mb-16 md:mb-20 text-center">
      <div class="mb-6 sm:mb-8 inline-block">
        <div class="line-accent w-10 sm:w-12 mx-auto mb-6 sm:mb-8"></div>
        <h2 class="about-title text-xl sm:text-2xl font-serif font-light tracking-[0.15em] text-ciava-warm md:text-3xl">
          QUIÉNES SOMOS
        </h2>
        <div class="line-accent w-10 sm:w-12 mx-auto mt-6 sm:mt-8"></div>
      </div>
    </div>

    <!-- Texto introductorio -->
    <div class="about-intro mb-16 sm:mb-20 md:mb-24 text-center">
      <div class="mx-auto max-w-4xl border border-white/5 bg-ciava-charcoal/30 px-6 py-8 sm:px-12 sm:py-12 md:px-16 md:py-16">
        <div class="space-y-4 sm:space-y-6 md:space-y-8 text-sm sm:text-base md:text-lg leading-relaxed text-white/60 lg:text-xl font-light">
          <p class="tracking-wide">
            Somos una fotógrafa y una productora de moda.
          </p>
          <p class="tracking-wide">
            Nos fusionamos desde miradas, recorridos y edades distintas, y ahí es donde nace Ciava Studio.
          </p>
          <p class="tracking-wide">
            Esa combinación nos permite abordar cada proyecto con sensibilidad estética, experiencia y una visión actual de la moda. Trabajamos de forma complementaria para crear producciones sólidas, coherentes y alineadas con la identidad de cada marca.
          </p>
        </div>
      </div>
    </div>

    <!-- Perfiles individuales -->
    <div class="grid gap-8 sm:gap-10 md:grid-cols-2 lg:gap-12">
      <!-- Florencia -->
      <div class="about-card group border border-white/5 bg-ciava-dark/60 p-6 sm:p-8 lg:p-10 transition-all duration-500 hover:border-ciava-gold/20 hover:bg-ciava-charcoal/60 hover:shadow-elevation-3 md:hover:-translate-y-2">
        <!-- Foto -->
        <div class="mb-6 overflow-hidden">
          <img 
            src={portadaFlor.src} 
            alt="Florencia Zoccola" 
            class="w-full aspect-square object-cover grayscale transition-all duration-700 group-hover:grayscale-0 group-hover:scale-105"
            loading="lazy"
          />
        </div>
        
        <div class="space-y-4 sm:space-y-6">
          <div class="border-l-2 border-ciava-gold/30 pl-4 sm:pl-6 transition-all duration-300 group-hover:border-ciava-gold/70">
            <h3 class="mb-1 text-base font-serif font-light tracking-[0.1em] text-ciava-warm sm:mb-2 sm:text-lg sm:tracking-[0.15em] transition-all duration-300">
              FLORENCIA ZOCCOLA
            </h3>
            <p class="text-[10px] tracking-wider text-ciava-gold/50 uppercase sm:text-xs">
              Fotógrafa
            </p>
            <a href="https://www.instagram.com/florzoccola.fotos?igsh=MWc3aXg1dzkyb3FwaA==" target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex items-center gap-1.5 text-[10px] sm:text-xs tracking-wider text-white/30 hover:text-ciava-gold transition-colors">
              <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              @florzoccola.fotos
            </a>
          </div>
          <div class="space-y-3 text-sm leading-relaxed text-white/50 font-light sm:space-y-4 sm:leading-loose">
            <p>
              Fotógrafa con más de 10 años de experiencia, formada en Motivarte (Buenos Aires) y especializada en fotografía de moda.
            </p>
            <p>
              Trabajo de manera integral cada proyecto, desde la dirección en la toma hasta la postproducción final, cuidando la estética, los detalles y los tiempos de entrega. También realizo contenido en video, creando piezas visuales coherentes y pensadas para potenciar la identidad de cada marca en redes y plataformas digitales.
            </p>
          </div>
        </div>
      </div>

      <!-- Valentina -->
      <div class="about-card group border border-white/5 bg-ciava-dark/60 p-6 sm:p-8 lg:p-10 transition-all duration-500 hover:border-ciava-gold/20 hover:bg-ciava-charcoal/60 hover:shadow-elevation-3 md:hover:-translate-y-2">
        <!-- Foto -->
        <div class="mb-6 overflow-hidden">
          <img 
            src={portadaValen.src} 
            alt="Valentina Bozzone" 
            class="w-full aspect-square object-cover grayscale transition-all duration-700 group-hover:grayscale-0 group-hover:scale-105"
            style="object-position: center 20%;"
            loading="lazy"
          />
        </div>
        
        <div class="space-y-4 sm:space-y-6">
          <div class="border-l-2 border-ciava-gold/30 pl-4 sm:pl-6 transition-all duration-300 group-hover:border-ciava-gold/70">
            <h3 class="mb-1 text-base font-serif font-light tracking-[0.1em] text-ciava-warm sm:mb-2 sm:text-lg sm:tracking-[0.15em] transition-all duration-300">
              VALENTINA BOZZONE
            </h3>
            <p class="text-[10px] tracking-wider text-ciava-gold/50 uppercase sm:text-xs">
              Productora de Moda
            </p>
            <a href="https://www.instagram.com/portfoliobyvalen?igsh=M2MybnpiMXpiaTRh" target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex items-center gap-1.5 text-[10px] sm:text-xs tracking-wider text-white/30 hover:text-ciava-gold transition-colors">
              <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              @portfoliobyvalen
            </a>
          </div>
          <div class="space-y-3 text-sm leading-relaxed text-white/50 font-light sm:space-y-4 sm:leading-loose">
            <p>
              Productora de moda recibida en la Universidad de Palermo.
            </p>
            <p>
              Me encargo de la dirección creativa/styling y de la producción integral de cada proyecto. Trabajo en la conceptualización de la idea, el armado de looks, la curaduría estética y la coordinación general de la producción, asegurando que cada imagen tenga coherencia, identidad y una lectura clara de marca.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { setupScrollAnimation, staggerReveal } from '../scripts/animations.js';

  document.addEventListener('astro:page-load', () => {
    setupScrollAnimation('.about-title', (el: Element) => {
      const htmlEl = el as HTMLElement;
      htmlEl.style.opacity = '0';
      htmlEl.style.transform = 'translateY(30px)';
      setTimeout(() => {
        htmlEl.style.transition = 'all 0.8s ease-out';
        htmlEl.style.opacity = '1';
        htmlEl.style.transform = 'translateY(0)';
      }, 100);
    });

    setupScrollAnimation('.about-team-photo', () => {
      staggerReveal('.about-team-photo', 0);
    });

    setupScrollAnimation('.about-intro', () => {
      staggerReveal('.about-intro', 0);
    });

    setupScrollAnimation('.about-card', () => {
      staggerReveal('.about-card', 200);
    });
  });
</script>
